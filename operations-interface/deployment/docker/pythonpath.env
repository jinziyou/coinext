# Deprecated for production images (packages come from `uv sync` into /opt/venv).
# Kept as a documented fallback for ad-hoc containers that mount source trees without installing
# the workspace. Prefer: `uv sync` + COINEXT_SERVICE_PYTHONPATH for the thin service app only.
#
# Lifecycle pure-Python roots (host or /app layout):
#   foundation/python
#   market-data/python
#   strategy-research/python
#   backtesting-simulation/python
#   analytics-optimization/python
#   risk-portfolio/python
#   execution-live/python
#   operations-interface/python
PYTHONPATH=/app/foundation/python:/app/market-data/python:/app/strategy-research/python:/app/backtesting-simulation/python:/app/analytics-optimization/python:/app/risk-portfolio/python:/app/execution-live/python:/app/operations-interface/python
