# Docker build-context excludes. Dockerfiles often `COPY . .`; keep the context small.

# Rust build output
target/
**/target/

# Python venv / build artifacts
.venv/
.uv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# maturin / pyo3 native artifacts
*.so
*.pyd

# Node / UI build output
**/node_modules/
operations-interface/services/ui/dist/
operations-interface/ui/

# Generic build/dist dirs
dist/
build/

# VCS / CI / editor
.git/
.github/
.idea/
.vscode/

# Docs and tests are not needed inside application images
docs/
tests/
**/*.md
!README.md

# Data lake (local) — not needed in the image
/data/*

# Secrets & local env / runtime state
.env
.env.*
!.env.example
.coinext/
*.db
*.sqlite

# Notebooks checkpoints
**/.ipynb_checkpoints/
